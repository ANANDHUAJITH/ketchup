[Icon Theme]
Name=Ketchup
Comment=Ketchup branding icons (override logo with ketchup-logo)
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
