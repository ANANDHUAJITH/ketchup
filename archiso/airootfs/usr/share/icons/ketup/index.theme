[Icon Theme]
Name=Ketup
Comment=Ketup branding icons (override logo with ketup-logo)
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
