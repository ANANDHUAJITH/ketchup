[Icon Theme]
Name=Ketchup Blue
Comment=Ketchup mythical-blue-mode branding icons (session only; see mythical-blue-ketchup / the-legacy-red-ketchup)
Inherits=breeze-dark,breeze,hicolor
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications
