#!/bin/bash
# Apply the Ketchup look once per user: dark theme, tomato accent, Ketchup icon theme, wallpaper.
M="${XDG_CONFIG_HOME:-$HOME/.config}/ketchup/first-login-done"
[ -f "$M" ] && exit 0
for _ in $(seq 40); do dbus-send --session --print-reply --dest=org.freedesktop.DBus / org.freedesktop.DBus.NameHasOwner string:org.kde.plasmashell 2>/dev/null | grep -q true && break; sleep 1; done
sleep 2
command -v plasma-apply-colorscheme >/dev/null && {
    plasma-apply-colorscheme BreezeDark >/dev/null 2>&1
    plasma-apply-colorscheme --accent-color '#e63a2e' >/dev/null 2>&1
}
command -v plasma-apply-wallpaperimage >/dev/null && \
    plasma-apply-wallpaperimage /usr/share/wallpapers/Ketchup/contents/images/1920x1080.png >/dev/null 2>&1
kwriteconfig6 --file kdeglobals --group Icons --key Theme ketchup
dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:4 int32:0 2>/dev/null
systemctl --user restart plasma-plasmashell.service 2>/dev/null
mkdir -p "$(dirname "$M")" && touch "$M"
