#!/bin/bash
# ketchup-first-login - apply the Ketchup wallpaper and icon theme once per user.
#
# ~/.config/noctalia/config.toml holds the declarative defaults; this script pushes
# them through Noctalia's IPC on the first login, then records a marker so it never
# overrides a wallpaper the user has chosen since.
set -u
M="${XDG_CONFIG_HOME:-$HOME/.config}/ketchup/first-login-done"
[ -f "$M" ] && exit 0

# wait for Noctalia to come up
for _ in $(seq 20); do
    pgrep -x noctalia >/dev/null 2>&1 && break
    sleep 0.5
done

command -v noctalia >/dev/null && \
    noctalia msg wallpaper-set /usr/share/backgrounds/ketchup/legacy-red-night.jpg >/dev/null 2>&1

command -v gsettings >/dev/null && \
    gsettings set org.gnome.desktop.interface icon-theme ketchup >/dev/null 2>&1

mkdir -p "$(dirname "$M")" && touch "$M"
