#!/bin/bash
# ketchup-doctor - collect diagnostics (boot time, IRQ problems, memory, network, installer libs)
# into ~/ketchup-diagnostics.txt so problems can be pasted into a bug report.
out="${HOME:-/tmp}/ketchup-diagnostics.txt"
sec() { printf '\n===== %s =====\n' "$1"; }
{
echo "Ketchup diagnostics $(date -u '+%F %T') UTC"
sec "Kernel / cmdline";      uname -a; cat /proc/cmdline
sec "Hardware";              inxi -F 2>/dev/null || { lscpu | head -20; lspci -nn; }
sec "Memory";                free -h; echo; ps -eo rss,comm --sort=-rss | head -12 | awk 'NR==1{print;next}{printf "%7.0f MB  %s\n",$1/1024,$2}'
sec "Mounts (is the image copied to RAM?)"; findmnt -o TARGET,SOURCE,FSTYPE,SIZE,USED / /run/archiso/cowspace /run/archiso/copytoram 2>/dev/null
sec "Boot time";             systemd-analyze 2>/dev/null; systemd-analyze blame 2>/dev/null | head -15
sec "Critical chain";        systemd-analyze critical-chain 2>/dev/null | head -25
sec "IRQ problems (irq N: nobody cared)"; dmesg 2>/dev/null | grep -iE -B2 -A12 'nobody cared|disabling IRQ|irq [0-9]+:' | head -60
sec "Who owns IRQ 27? (ketchup-irqfix)"; /usr/local/bin/ketchup-irqfix 27 2>&1 | head -40
sec "Interrupt counts (top 12)"; sort -k2 -n -r /proc/interrupts 2>/dev/null | head -12
sec "NetworkManager";        systemctl is-enabled NetworkManager 2>&1; systemctl status NetworkManager --no-pager 2>&1 | head -15; journalctl -b -u NetworkManager --no-pager 2>/dev/null | tail -25; nmcli device status 2>&1
sec "Failed units";          systemctl --failed --no-pager 2>&1
sec "Installer (calamares) libraries"
if command -v calamares >/dev/null; then ldd "$(command -v calamares)" 2>&1 | grep -E 'not found|boost' ; ls /usr/lib/ketchup-compat 2>&1 | head; else echo "calamares not installed"; fi
sec "Branding";              cat /etc/os-release
sec "Journal errors (this boot)"; journalctl -b -p err --no-pager 2>/dev/null | tail -30
} > "$out" 2>&1
echo "Wrote $out ($(wc -l < "$out") lines)."
echo "Quick summary:"; systemd-analyze 2>/dev/null | head -1
free -h | sed -n 1,2p
grep -qiE 'nobody cared' <(dmesg 2>/dev/null) && echo "!! 'nobody cared' IRQ message seen: run 'ketchup-irqfix N' (N = the IRQ number) to see which device owns it; the live menu has an 'IRQ troubleshooting' submenu." || true
