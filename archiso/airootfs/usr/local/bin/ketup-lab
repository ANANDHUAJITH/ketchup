#!/bin/bash
# ketup-lab - hands-on labs for studying networking and operating-system internals.
#   ketup-lab list
#   ketup-lab net up|down|status|shell a|r|b     3 network namespaces joined by a router
#   ketup-lab kmod new NAME                       Linux kernel module skeleton (hello world)
#   ketup-lab boot new NAME                       512-byte x86 boot sector, run in QEMU
#   ketup-lab syscalls new NAME                   C program using raw syscalls (watch with strace)
# Notes for each lab: /usr/share/doc/ketup/STUDY.md
set -u
LABDIR="${KETUP_LABS:-$HOME/ketup-labs}"
need_root() { [ "$EUID" -eq 0 ] || exec sudo "$0" "$@"; }

net_up() {
    need_root net up
    command -v ip >/dev/null || { echo "ip not found (package iproute2)"; return 1; }
    ip netns list | grep -q '^ketup-a' && { echo "lab already up (ketup-lab net down first)"; return 1; }
    for n in a r b; do ip netns add ketup-$n; ip -n ketup-$n link set lo up; done
    ip link add veth-ar type veth peer name veth-ra
    ip link add veth-br type veth peer name veth-rb
    ip link set veth-ar netns ketup-a; ip link set veth-ra netns ketup-r
    ip link set veth-br netns ketup-b; ip link set veth-rb netns ketup-r
    ip -n ketup-a addr add 10.10.1.2/24 dev veth-ar; ip -n ketup-a link set veth-ar up
    ip -n ketup-r addr add 10.10.1.1/24 dev veth-ra; ip -n ketup-r link set veth-ra up
    ip -n ketup-r addr add 10.10.2.1/24 dev veth-rb; ip -n ketup-r link set veth-rb up
    ip -n ketup-b addr add 10.10.2.2/24 dev veth-br; ip -n ketup-b link set veth-br up
    ip -n ketup-a route add default via 10.10.1.1
    ip -n ketup-b route add default via 10.10.2.1
    ip netns exec ketup-r sysctl -qw net.ipv4.ip_forward=1
    cat <<'EOF'
Lab up:   [a 10.10.1.2] --- [r 10.10.1.1 | 10.10.2.1] --- [b 10.10.2.2]
Try:
  sudo ip netns exec ketup-a ping -c2 10.10.2.2            # crosses the router
  sudo ip netns exec ketup-r tcpdump -ni veth-ra icmp      # watch it arrive (second terminal)
  sudo ip netns exec ketup-r sysctl -w net.ipv4.ip_forward=0   # break routing, ping again
  ketup-lab net shell r      # then: ip route; ip neigh; nft list ruleset
Ideas: add NAT with nft masquerade, a firewall rule dropping tcp/22, a bridge, VLANs, MTU limits.
EOF
}
net_down() { need_root net down; for n in a r b; do ip netns del ketup-$n 2>/dev/null; done; echo "lab removed"; }
net_status() { ip netns list; for n in a r b; do echo "--- ketup-$n"; ip -n ketup-$n -br addr 2>/dev/null; done; }
net_shell() { need_root net shell "$1"; [ -n "${1:-}" ] || { echo "usage: ketup-lab net shell a|r|b"; return 1; }; exec ip netns exec "ketup-$1" env PS1="[ns-$1] \w # " bash --norc -i; }

new_dir() { d="$LABDIR/$1-$2"; [ -e "$d" ] && { echo "$d already exists"; return 1; }; mkdir -p "$d"; echo "$d"; }

kmod_new() {
    local n="${1:-}"; [[ "$n" =~ ^[a-z][a-z0-9_]*$ ]] || { echo "usage: ketup-lab kmod new NAME (lowercase letters/digits/_)"; return 1; }
    local d; d="$(new_dir kmod "$n")" || return 1
    cat > "$d/$n.c" <<EOF
#include <linux/init.h>
#include <linux/kernel.h>
#include <linux/module.h>

static int __init ${n}_init(void)
{
	pr_info("$n: hello from kernel space\n");
	return 0;
}

static void __exit ${n}_exit(void)
{
	pr_info("$n: goodbye\n");
}

module_init(${n}_init);
module_exit(${n}_exit);
MODULE_LICENSE("GPL");
MODULE_DESCRIPTION("Ketup study module");
EOF
    printf 'obj-m += %s.o\nKDIR ?= /lib/modules/$(shell uname -r)/build\n\nall:\n\t$(MAKE) -C $(KDIR) M=$(PWD) modules\nclean:\n\t$(MAKE) -C $(KDIR) M=$(PWD) clean\n' "$n" > "$d/Makefile"
    echo "Created $d  (needs linux-zen-headers + base-devel, both on the ISO)"
    echo "  cd $d && make && sudo insmod $n.ko && sudo dmesg | tail -3 && sudo rmmod $n"
    echo "  modinfo $n.ko ; lsmod | head ; cat /proc/modules | grep $n"
}

boot_new() {
    local n="${1:-}"; [[ "$n" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "usage: ketup-lab boot new NAME"; return 1; }
    local d; d="$(new_dir boot "$n")" || return 1
    cat > "$d/boot.asm" <<'EOF'
; 16-bit real-mode boot sector: the BIOS loads these 512 bytes at 0x7C00 and jumps to them.
[org 0x7c00]
    mov si, msg
.next:
    lodsb                ; AL = *SI++
    or  al, al
    jz  .halt
    mov ah, 0x0e         ; BIOS teletype output
    int 0x10
    jmp .next
.halt:
    cli
    hlt
    jmp .halt
msg: db "Hello from a Ketup boot sector!", 0
times 510-($-$$) db 0    ; pad to 510 bytes
dw 0xaa55                ; boot signature the BIOS looks for
EOF
    printf 'boot.bin: boot.asm\n\tnasm -f bin boot.asm -o boot.bin\nrun: boot.bin\n\tqemu-system-x86_64 -drive format=raw,file=boot.bin\ndebug: boot.bin\n\tqemu-system-x86_64 -drive format=raw,file=boot.bin -S -s &\n\tgdb -ex "target remote :1234" -ex "set architecture i8086" -ex "break *0x7c00" -ex c\nclean:\n\trm -f boot.bin\n' > "$d/Makefile"
    echo "Created $d   (install tools: ketup-devtools install os)"
    echo "  cd $d && make run      # boots in QEMU;  make debug  attaches gdb at 0x7c00"
}

sys_new() {
    local n="${1:-}"; [[ "$n" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "usage: ketup-lab syscalls new NAME"; return 1; }
    local d; d="$(new_dir syscalls "$n")" || return 1
    cat > "$d/main.c" <<'EOF'
#define _GNU_SOURCE
#include <sys/syscall.h>
#include <unistd.h>
#include <string.h>

/* No libc wrappers: talk to the kernel directly through syscall(2). */
int main(void)
{
	const char *msg = "hello via raw syscalls\n";
	syscall(SYS_write, 1, msg, strlen(msg));
	syscall(SYS_getpid);
	syscall(SYS_exit_group, 0);
}
EOF
    printf 'main: main.c\n\tgcc -O0 -g -o main main.c\ntrace: main\n\tstrace -f ./main\nclean:\n\trm -f main\n' > "$d/Makefile"
    echo "Created $d"; echo "  cd $d && make && ./main && make trace   # compare with: strace -c ls"
}

case "${1:-list}" in
    list) sed -n '2,8p' "$0" ;;
    net) case "${2:-}" in up) net_up ;; down) net_down ;; status) net_status ;; shell) net_shell "${3:-}" ;; *) sed -n '5,5p' "$0" ;; esac ;;
    kmod)  [ "${2:-}" = new ] && kmod_new "${3:-}"  || sed -n '6p' "$0" ;;
    boot)  [ "${2:-}" = new ] && boot_new "${3:-}"  || sed -n '7p' "$0" ;;
    syscalls) [ "${2:-}" = new ] && sys_new "${3:-}" || sed -n '8p' "$0" ;;
    *) sed -n '2,9p' "$0" ;;
esac
