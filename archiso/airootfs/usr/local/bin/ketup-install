#!/bin/bash
# Start the Ketup (Calamares) installer from the live session.
log="${HOME:-/tmp}/ketup-install.log"
timedatectl set-ntp true 2>/dev/null || true
echo "Ketup installer started $(date -u '+%F %T') UTC" >> "$log"
if [ -d /sys/firmware/efi ]; then echo "Firmware: UEFI" >> "$log"; else echo "Firmware: BIOS" >> "$log"; fi
inxi -F >> "$log" 2>&1 || true
exec pkexec-wrapper calamares -D6 >> "$log" 2>&1
