#!/bin/bash
# Start the Ketchup (Calamares) installer from the live session.
log="${HOME:-/tmp}/ketchup-install.log"
timedatectl set-ntp true 2>/dev/null || true
echo "Ketchup installer started $(date -u '+%F %T') UTC" >> "$log"
if [ -d /sys/firmware/efi ]; then echo "Firmware: UEFI" >> "$log"; else echo "Firmware: BIOS" >> "$log"; fi
inxi -F >> "$log" 2>&1 || true
# Overlay the Ketchup installer config on top of the package defaults
# (shipping it in /etc/calamares would conflict with the package at build time).
sudo mkdir -p /etc/calamares
sudo cp -rf /usr/share/ketchup/calamares/. /etc/calamares/
sudo ldconfig 2>/dev/null   # picks up /usr/lib/ketchup-compat (older boost for calamares)
exec pkexec-wrapper calamares -D6 >> "$log" 2>&1
