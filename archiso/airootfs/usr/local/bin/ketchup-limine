#!/bin/bash
# ketchup-limine - manage the Limine boot loader of an installed Ketchup system.
#
#   ketchup-limine install     (Calamares, inside the target chroot) put Limine on the disk
#   ketchup-limine update      regenerate the boot menu from /boot (run by the pacman hook)
#   ketchup-limine status      show what is installed and the kernel command line
#   ketchup-limine pin on|off  hash-pin kernel + initramfs + config (tamper detection)
#
# Layout: the EFI System Partition (ESP) is mounted at /boot, because Limine cannot read btrfs.
#   /boot/limine.conf        generated menu (do not edit, edit the two files below instead)
#   /etc/kernel/cmdline      base command line (root=..., set once by the installer)
#   /etc/ketchup/boot-extra  extra options (quiet, noirqdebug, ...) - edit, then: sudo ketchup-limine update
# BIOS machines: Limine needs a readable /boot (ext4/FAT). Otherwise this script installs GRUB instead.
set -u
ROOT="${KETCHUP_ROOT:-}"                       # test mode: operate on another tree, touch no disks
BOOT="$ROOT/boot"
CMDFILE="$ROOT/etc/kernel/cmdline"
EXTRAFILE="$ROOT/etc/ketchup/boot-extra"
PINFILE="$ROOT/etc/ketchup/limine-pin"
SHARE="${LIMINE_SHARE:-/usr/share/limine}"
DEFAULT_EXTRA="quiet loglevel=3 nowatchdog zswap.enabled=0 noirqdebug"
OSNAME="$( . "$ROOT/etc/os-release" 2>/dev/null; echo "${NAME:-Ketchup}" )"

log() { echo "ketchup-limine: $*"; }
die() { echo "ketchup-limine: $*" >&2; exit 1; }
live() { [ -z "$ROOT" ] && [ -d /run/archiso ]; }
is_uefi() { [ -n "$ROOT" ] && return 0; [ -d /sys/firmware/efi ]; }
b2() { b2sum "$1" | cut -d' ' -f1; }

# ---------------------------------------------------------------- command line
fstab_field() {  # fstab_field MOUNTPOINT FIELDNO
    awk -v m="$1" -v n="$2" '$1 !~ /^#/ && $2 == m { print $n; exit }' "$ROOT/etc/fstab" 2>/dev/null
}

make_base_cmdline() {
    local dev fs opts sub line crypt_name crypt_dev
    dev="$(fstab_field / 1)"; fs="$(fstab_field / 3)"; opts="$(fstab_field / 4)"
    [ -n "$dev" ] || die "no / entry in /etc/fstab"
    line="root=$dev rw"
    sub="$(tr ',' '\n' <<<"$opts" | sed -n 's/^subvol=//p' | head -n1)"
    [ "$fs" = btrfs ] && [ -n "$sub" ] && line+=" rootflags=subvol=$sub"
    case "$dev" in /dev/mapper/*)                       # LUKS root: tell the initramfs what to unlock
        crypt_name="${dev#/dev/mapper/}"
        crypt_dev="$(awk -v n="$crypt_name" '$1 == n { print $2; exit }' "$ROOT/etc/crypttab" 2>/dev/null)"
        [ -n "$crypt_dev" ] && line+=" cryptdevice=$crypt_dev:$crypt_name" ;;
    esac
    echo "$line"
}

extra_opts() { [ -f "$EXTRAFILE" ] && tr '\n' ' ' < "$EXTRAFILE" || echo "$DEFAULT_EXTRA"; }

# ---------------------------------------------------------------- menu generation
generate_conf() {
    local out="$1" base extra pin=0 compat kimg base_name n ucode="" p
    base="$(tr '\n' ' ' < "$CMDFILE")"; extra="$(extra_opts)"
    [ -f "$PINFILE" ] && pin=1
    base="$(echo $base)"; extra="$(echo $extra)"               # normalise whitespace
    compat="$(echo ${extra//noirqdebug/} irqpoll pci=nomsi)"
    h() { [ "$pin" = 1 ] && echo "#$(b2 "$1")"; }       # "#hash" suffix when pinned

    {
    echo "# Generated by ketchup-limine on $(date -u '+%F %T') UTC - do not edit."
    echo "# Edit /etc/kernel/cmdline or /etc/ketchup/boot-extra, then run: sudo ketchup-limine update"
    echo "timeout: 5"
    echo "editor_enabled: no"
    echo "interface_branding: $OSNAME"
    echo "interface_branding_color: 1"
    [ -f "$BOOT/ketchup/wallpaper.png" ] && { echo "wallpaper: boot():/ketchup/wallpaper.png"; echo "wallpaper_style: stretched"; }
    echo "term_background: 40000000"
    for p in amd-ucode.img intel-ucode.img; do
        [ -f "$BOOT/$p" ] && ucode+="    module_path: boot():/$p$(h "$BOOT/$p")"$'\n'
    done
    for kimg in "$BOOT"/vmlinuz-*; do
        [ -f "$kimg" ] || continue
        base_name="${kimg##*/vmlinuz-}"
        n="$OSNAME ($base_name)"
        [ -f "$BOOT/initramfs-$base_name.img" ] || continue
        echo
        echo "/$n"
        echo "    protocol: linux"
        echo "    path: boot():/vmlinuz-$base_name$(h "$kimg")"
        printf '%s' "$ucode"
        echo "    module_path: boot():/initramfs-$base_name.img$(h "$BOOT/initramfs-$base_name.img")"
        echo "    cmdline: $base $extra"
        echo
        echo "/$OSNAME ($base_name) - IRQ compat (irqpoll, pci=nomsi)"
        echo "    protocol: linux"
        echo "    path: boot():/vmlinuz-$base_name$(h "$kimg")"
        printf '%s' "$ucode"
        echo "    module_path: boot():/initramfs-$base_name.img$(h "$BOOT/initramfs-$base_name.img")"
        echo "    cmdline: $base $compat"
        if [ -f "$BOOT/initramfs-$base_name-fallback.img" ]; then
            echo
            echo "/$OSNAME ($base_name) - fallback initramfs"
            echo "    protocol: linux"
            echo "    path: boot():/vmlinuz-$base_name$(h "$kimg")"
            printf '%s' "$ucode"
            echo "    module_path: boot():/initramfs-$base_name-fallback.img$(h "$BOOT/initramfs-$base_name-fallback.img")"
            echo "    cmdline: $base $extra"
        fi
    done
    # Windows on the same ESP (dual boot)
    if [ -f "$BOOT/EFI/Microsoft/Boot/bootmgfw.efi" ]; then
        echo; echo "/Windows"; echo "    protocol: efi"; echo "    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi"
    fi
    } > "$out"
}

install_efi_files() {
    local d
    [ -r "$SHARE/BOOTX64.EFI" ] || die "$SHARE/BOOTX64.EFI missing (package 'limine')"
    for d in "$BOOT/EFI/BOOT" "$BOOT/EFI/limine"; do
        install -Dm644 "$SHARE/BOOTX64.EFI" "$d/BOOTX64.EFI" || die "cannot write to $d (is the ESP mounted at /boot?)"
    done
    [ -r "$SHARE/BOOTIA32.EFI" ] && install -Dm644 "$SHARE/BOOTIA32.EFI" "$BOOT/EFI/BOOT/BOOTIA32.EFI"
    [ -f "$ROOT/usr/share/ketchup/limine-wallpaper.png" ] &&
        install -Dm644 "$ROOT/usr/share/ketchup/limine-wallpaper.png" "$BOOT/ketchup/wallpaper.png"
    return 0
}

do_update() {
    live && { log "live session: nothing to do"; return 0; }
    [ -f "$CMDFILE" ] || { mkdir -p "$(dirname "$CMDFILE")"; make_base_cmdline > "$CMDFILE" || die "cannot build command line"; }
    [ -d "$BOOT" ] || die "$BOOT not found"
    if [ -d "$BOOT/grub" ] && ! [ -f "$BOOT/limine.conf" ]; then   # GRUB fallback system
        log "GRUB fallback install detected; regenerating grub.cfg"
        [ -z "$ROOT" ] && grub-mkconfig -o /boot/grub/grub.cfg; return 0
    fi
    is_uefi && install_efi_files
    local tmp; tmp="$(mktemp)"
    generate_conf "$tmp"
    install -Dm644 "$tmp" "$BOOT/limine.conf"; rm -f "$tmp"
    if is_uefi; then
        if [ -f "$PINFILE" ] && command -v limine >/dev/null; then       # bind the config to the loader
            limine enroll-config "$BOOT/EFI/BOOT/BOOTX64.EFI" "$(b2 "$BOOT/limine.conf")" >/dev/null &&
            limine enroll-config "$BOOT/EFI/limine/BOOTX64.EFI" "$(b2 "$BOOT/limine.conf")" >/dev/null &&
            log "config hash enrolled into the EFI loader"
        fi
    fi
    log "boot menu updated ($(grep -c '^/' "$BOOT/limine.conf") entries)"
}

# ---------------------------------------------------------------- install (Calamares)
esp_disk_and_part() {   # prints "<disk> <partnumber>" of the partition mounted at /boot
    local u dev part disk num
    u="$(fstab_field /boot 1)"; [ -n "$u" ] || return 1
    case "$u" in UUID=*) dev="$(blkid -U "${u#UUID=}")" ;; PARTUUID=*) dev="$(blkid -t "$u" -o device | head -n1)" ;; *) dev="$u" ;; esac
    [ -b "$dev" ] || return 1
    part="${dev##*/}"; num="$(cat "/sys/class/block/$part/partition" 2>/dev/null)"
    disk="/dev/$(lsblk -no PKNAME "$dev" | head -n1)"
    [ -b "$disk" ] && [ -n "$num" ] && echo "$disk $num"
}

grub_fallback() {
    log "installing GRUB instead of Limine: $1"
    local u dev disk
    u="$(fstab_field / 1)"
    case "$u" in UUID=*) dev="$(blkid -U "${u#UUID=}")" ;; *) dev="$u" ;; esac
    disk="/dev/$(lsblk -no PKNAME "$dev" | head -n1)"
    [ -b "$disk" ] || die "cannot find the disk for $u"
    grub-install --target=i386-pc "$disk" || die "grub-install failed"
    grub-mkconfig -o /boot/grub/grub.cfg || die "grub-mkconfig failed"
}

do_install() {
    mkdir -p "$(dirname "$CMDFILE")" "$(dirname "$EXTRAFILE")"
    make_base_cmdline > "$CMDFILE" || die "cannot build the kernel command line"
    [ -f "$EXTRAFILE" ] || echo "$DEFAULT_EXTRA" > "$EXTRAFILE"
    log "kernel command line: $(cat "$CMDFILE") $(extra_opts)"

    if ! is_uefi; then                                                  # legacy BIOS
        local bootfs; bootfs="$(fstab_field /boot 3)"; [ -z "$bootfs" ] && bootfs="$(fstab_field / 3)"
        case "$bootfs" in
            ext2|ext3|ext4|vfat)
                do_update
                local disk; disk="/dev/$(lsblk -no PKNAME "$(blkid -U "$(fstab_field / 1 | sed 's/^UUID=//')")" | head -n1)"
                install -Dm644 "$SHARE/limine-bios.sys" /boot/limine/limine-bios.sys
                limine bios-install "$disk" || grub_fallback "limine bios-install failed on $disk" ;;
            *) grub_fallback "/boot is '$bootfs', which Limine cannot read" ;;
        esac
        return 0
    fi

    do_update
    local dp
    if dp="$(esp_disk_and_part)"; then
        # shellcheck disable=SC2086
        set -- $dp
        efibootmgr --create --disk "$1" --part "$2" --loader '\EFI\limine\BOOTX64.EFI' --label "Ketchup" >/dev/null 2>&1 \
            && log "EFI boot entry created" || log "could not write an EFI boot entry; the fallback path EFI/BOOT/BOOTX64.EFI will be used"
    else
        log "could not identify the ESP; fallback path EFI/BOOT/BOOTX64.EFI will be used"
    fi
}

do_status() {
    echo "Loader:     $(live && echo 'live session' || { is_uefi && echo 'Limine (UEFI)' || echo 'BIOS'; })"
    [ -f "$BOOT/limine.conf" ] && echo "Menu:       $BOOT/limine.conf ($(grep -c '^/' "$BOOT/limine.conf") entries)"
    [ -f "$CMDFILE" ] && echo "Base:       $(cat "$CMDFILE")"
    echo "Extra:      $(extra_opts)"
    echo "Hash pin:   $([ -f "$PINFILE" ] && echo ON || echo off)"
    command -v limine >/dev/null && limine --version 2>/dev/null | head -n1
}

case "${1:-status}" in
    install) do_install ;;
    update)  do_update ;;
    status)  do_status ;;
    pin)     case "${2:-}" in
                 on)  mkdir -p "$(dirname "$PINFILE")"; touch "$PINFILE"; do_update ;;
                 off) rm -f "$PINFILE"; do_update ;;
                 *)   die "usage: ketchup-limine pin on|off" ;;
             esac ;;
    -h|--help|help) sed -n '2,15p' "$0" ;;
    *) die "unknown command '$1' (try --help)" ;;
esac
