#!/bin/bash
# ketchup-version - show, or (internally) update, Ketchup's release train number.
#
#   ketchup-version                 print the current version/codename
#   ketchup-version --json          machine-readable
#   ketchup-version --set V [NAME]  used by ketchup-upgrade after a major bump; not for routine use
set -u
RELEASE_FILE="${KETCHUP_RELEASE_FILE:-/etc/ketchup-release}"

die() { echo "ketchup-version: $*" >&2; exit 1; }

case "${1:-}" in
    --set)
        [ "$EUID" = 0 ] || die "--set must be run as root (ketchup-upgrade does this for you)"
        ver="${2:-}"; [ -n "$ver" ] || die "usage: ketchup-version --set VERSION [CODENAME]"
        name="${3:-}"
        ts="$(date -Iseconds)"
        tmp="$(mktemp)"
        grep -v '^KETCHUP_VERSION=\|^KETCHUP_CODENAME=\|^KETCHUP_LAST_UPGRADE=' "$RELEASE_FILE" 2>/dev/null > "$tmp" || true
        {
            cat "$tmp"
            echo "KETCHUP_VERSION=$ver"
            echo "KETCHUP_CODENAME=$name"
            echo "KETCHUP_LAST_UPGRADE=$ts"
        } > "$RELEASE_FILE"
        rm -f "$tmp"
        sed -i "s/^VERSION=.*/VERSION=\"$ver\"/; s/^VERSION_ID=.*/VERSION_ID=$ver/" /etc/os-release 2>/dev/null
        exit 0
        ;;
    --json)
        # shellcheck source=/dev/null
        . "$RELEASE_FILE" 2>/dev/null
        printf '{"version":"%s","codename":"%s","last_upgrade":"%s"}\n' \
            "${KETCHUP_VERSION:-unknown}" "${KETCHUP_CODENAME:-}" "${KETCHUP_LAST_UPGRADE:-}"
        exit 0
        ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
esac

# shellcheck source=/dev/null
. "$RELEASE_FILE" 2>/dev/null
echo "Ketchup ${KETCHUP_VERSION:-unknown}${KETCHUP_CODENAME:+ \"$KETCHUP_CODENAME\"} (rolling)"
[ -n "${KETCHUP_LAST_UPGRADE:-}" ] && echo "Last ketchup-upgrade: $KETCHUP_LAST_UPGRADE"
echo "Kernel: $(uname -r)"
