// Ketchup default niri configuration.

spawn-at-startup "xwayland-satellite"

// Starts NetworkManager if ~/.bash_profile did not. Allowed without a password by
// /etc/sudoers.d/ketchup-networkmanager; starting a running unit is a no-op.
spawn-at-startup "sudo" "-n" "/usr/bin/systemctl" "start" "NetworkManager.service"

// Noctalia owns the wallpaper and the first-run state (see ~/.config/noctalia/config.toml
// and ~/.local/state/noctalia/settings.toml, which ship with setup_wizard_enabled = false).
// --daemon is required: without it Noctalia crashes on startup on this image.
spawn-at-startup "noctalia" "--daemon"

// niri does not process /etc/xdg/autostart, so these are started here.
spawn-at-startup "ketchup-blue-reset-check"
spawn-at-startup "ketchup-first-login"

input {
    keyboard {
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
    }
    // let Noctalia's wallpaper layer show through the overview backdrop
    background-color "transparent"
}

// Noctalia (notifications, OSDs, settings window) activates windows without a valid serial.
debug {
    honor-xdg-activation-with-invalid-serial
}

// Noctalia's settings window floats at a fixed size.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Noctalia's wallpaper stays on the backdrop instead of scrolling with the columns.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

binds {
    Mod+Return { spawn "alacritty"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+Q       { close-window; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Print { screenshot; }
    Mod+Shift+E { quit; }
    Mod+Shift+Q { spawn "swaylock"; }
}
