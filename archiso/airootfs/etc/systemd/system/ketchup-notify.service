[Unit]
Description=Check Ketchup's notif.yml and notify logged-in users of new announcements
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/ketchup-notifyd

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ketchup-notifyd
# Needs to relay into user session buses (see notify-lib.sh) and to log.
User=root
